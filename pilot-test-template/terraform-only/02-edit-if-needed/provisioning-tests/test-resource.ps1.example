[CmdletBinding()]
param(
    [Parameter(Mandatory)]
    [string]$TestContextFile,
    [Parameter(Mandatory)]
    [string]$ProjectRoot,
    [ValidateRange(60, 7200)]
    [int]$WaitSeconds = 1800
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

$context = Get-Content -LiteralPath $TestContextFile -Raw | ConvertFrom-Json
if ($null -eq $context -or @($context.PSObject.Properties).Count -eq 0) {
    throw "The provisioning test context is empty."
}

